
export UV_PROJECT_ENVIRONMENT=/leonardo_scratch/large/userexternal/<user>/automodel_venv
export UV_CACHE_DIR=/leonardo_scratch/large/userexternal/<user>/.cache/uv
export UV_LINK_MODE=copy
export HF_HOME=/leonardo_work/FAIR_NLP/<user>/hf_cache
export TRITON_CACHE_DIR=/leonardo_scratch/large/userexternal/<user>/.triton
export TORCHINDUCTOR_CACHE_DIR=/leonardo_scratch/large/userexternal/<user>/.inductor

source $UV_PROJECT_ENVIRONMENT/bin/activate
export PYTHONPATH=${PYTHONPATH:-}:./src

# Transformer Engine: point its "system" lookup at the venv's pip CUDA libs; otherwise it
# takes the no-toolkit path and fails to find cudart (pip dir is cuda_runtime, not cudart).
export NVRTC_PATH=$UV_PROJECT_ENVIRONMENT/lib/python3.12/site-packages/nvidia/cuda_nvrtc
export CURAND_PATH=$UV_PROJECT_ENVIRONMENT/lib/python3.12/site-packages/nvidia/curand

export HF_TOKEN="<hf_token>"
export WANDB_API_KEY="<wandb_api_key>"
